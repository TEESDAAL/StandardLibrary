ThrowArithTests: Test {::
  .checkDetErr({::}, {12 .getDiv 0})
  .checkDetErr({::}, {+12 .getDiv 0})
  .checkDetErr({::}, {+12.getByte .getDiv 0})
  .checkDetErr({::}, {+12/3 / (+0/1)})
  .checkDetErr({::}, {Math.maxNat + 1})
  .checkDetErr({::}, {Math.minNat - 1})
  .checkDetErr({::}, {4_294_967_296 * 4_294_967_296})
  .checkDetErr({::}, {Math.maxInt + +1})
  .checkDetErr({::}, {Math.minInt - +1})
  .checkDetErr({::}, {Math.maxInt - +2 * +2})
  .check{Math.minInt.abs.assertEq(Math.maxInt.getNat + 1)}
  .checkDetErr({::}, {+250.getByte + (+10.getByte)})
  .checkDetErr({::}, {Math.minByte - (+1.getByte)})
  .checkDetErr({::}, {+7.getWrapIndex 0})
  .checkDetErr({::}, {Math.minNat.getIndexOffset -1})
  .checkDetErr({::}, {Math.maxNat.getIndexOffset +1})
  }

ThrowListTests: Test {::
  .checkDetErr({::}, {List[Str].get 0})
  .checkDetErr({::}, {List[Str].getFirst})
  .checkDetErr({::}, {List[Str].getLast})
  .checkDetErr({::}, {List[Str].with(0,`x`)})
  .checkDetErr({::}, {List[Str].without 0})
  .checkDetErr({::}, {List[Str].withAlso(1,`x`)})
  .checkDetErr({::}, {Lists#(`a`).get 1})
  .checkDetErr({::}, {Lists#(`a`).without 1})
  .checkDetErr({::}, {Lists#(`a`).with(1,`b`)})
  .checkDetErr({::}, {Lists#(`a`).withAlso(2,`b`)})
  .checkDetErr({::}, {Lists#(`a`,`b`).subList(0,3)})
  .checkDetErr({::}, {List[Str].subList(0,3)})
  }

ThrowMapTests: Test {::
  .checkDetErr({::}, {Maps#[Str,Str,Str] {::}.get `a`})
  .checkDetErr({::}, {Maps#[Str,Str,Str] {::}.without `a`})
  .checkDetErr({::}, {Maps#({::}, `a`, `x`).get `b`})
  .checkDetErr({::}, {Maps#({::}, `a`, `x`).without `b`})
  }

TestLiteralErrors: Test {::
  .test ThrowArithTests
  .test ThrowListTests
  //.test ThrowMapTests
  }
